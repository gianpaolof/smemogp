# Turso (libSQL). Locale: TURSO_DATABASE_URL=file:/percorso/assoluto/local.db
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Scout: estrazione LLM, solo per fonti con "llm": true in sources.json
ANTHROPIC_API_KEY=
# Default claude-haiku-5-5
SCOUT_LLM_MODEL=

# Geocoding Nominatim: User-Agent obbligatorio con contatto
NOMINATIM_USER_AGENT=smemogp-scout/0.1 (tua-email@example.com)

# Eventbrite (opzionale)
EVENTBRITE_TOKEN=

# Invalidazione cache del sito a fine run scout (opzionale; stesso segreto su Vercel e GitHub)
SITE_URL=https://<progetto>.vercel.app
REVALIDATE_SECRET=
