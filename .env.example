# Turso (libSQL). Locale: TURSO_DATABASE_URL=file:/percorso/assoluto/local.db
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Scout: LLM via OpenRouter (estrazione per fonti con "llm": true e ricerca web `scout:search`).
# Metti un limite di credito sulla chiave in openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Id OpenRouter (openrouter.ai/models). Default anthropic/claude-haiku-5.5; prova con `npm run scout:probe -- --model <id>`
SCOUT_LLM_MODEL=
# Ricerca web: modello, motore (exa | parallel | perplexity | native | auto; default exa), tetto di spesa per run in USD (default 0.5)
SCOUT_SEARCH_MODEL=
SCOUT_SEARCH_ENGINE=
SCOUT_SEARCH_MAX_USD=

# Geocoding Nominatim: User-Agent obbligatorio con contatto
NOMINATIM_USER_AGENT=smemogp-scout/0.1 (tua-email@example.com)

# Eventbrite (opzionale)
EVENTBRITE_TOKEN=

# Invalidazione cache del sito a fine run scout (opzionale; stesso segreto su Vercel e GitHub)
SITE_URL=https://<progetto>.vercel.app
REVALIDATE_SECRET=
