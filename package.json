{
  "name": "smemogp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "scout": "npm run start -w scout --",
    "scout:ingest": "npm run ingest -w scout --",
    "scout:verify": "npm run verify -w scout --",
    "scout:search": "npm run search -w scout --",
    "scout:probe": "npm run probe -w scout --",
    "scout:test": "npm run test -w scout",
    "db:generate": "npm run generate -w @smemogp/db",
    "db:migrate": "npm run migrate -w @smemogp/db",
    "db:studio": "npm run studio -w @smemogp/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scout:prune-excluded": "npm run prune-excluded -w scout --",
    "scout:restore": "npm run restore -w scout --"
  }
}
